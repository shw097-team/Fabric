+        disp.reset_carrier_surrogate_count()
+        self.assertEqual(disp.agent_message_texts(good), ["astral \U0001F600 HGK_LANE_NONCE_OK"])
+        self.assertEqual(disp.carrier_surrogate_count(), 0)
