  revision: 13
  sha256: 03a7547f5f573daae22e91f599c2d8edce2c42688f4740e19c1ef3472fee1b4e

# canonical_identity is the normalized model token used by the maker!=checker comparison.
# auth is a non-secret descriptor only; no credential value is ever stored or logged.
routes:
  - lane: PLAN
    role_group: PLAN
    lanes:
      - ARCH
      - HARD WORK
      - THREAT
      - EFFECT PLANNING
      - RESEARCH
      - SYNTHESIS
      - EVOLUTION
    engine: hermes
    provider: openai-codex
    model: gpt-6.1-sol
    canonical_identity: gpt-6.1-sol
    auth: openai_oauth
    oauth: true
    reasoning_effort: high
    fallbacks: []
    admission_status: UNPROVEN

  - lane: EXECUTE
    role_group: EXECUTE
    lanes:
      - BULK BUILD
      - BULK SECURITY TEST
      - REPAIR
      - BULK CODE
      - HARNESS
      - EVAL CODE
      - BULK TRANSFORM
    engine: codex-cli
    provider: opencode-go
    model: deepseek-v4.1-flash
    canonical_identity: deepseek-v4.1-flash
    auth: env_ref:OPENCODE_GO_API_KEY
    oauth: false
    fallbacks: []
    admission_status: UNPROVEN

  - lane: VERIFY_SECURITY
    role_group: VERIFY_SECURITY
    lanes:
      - ACCEPTANCE
      - SECURITY REVIEW
      - VERIFY
    engine: hermes
    provider: openai-codex
    model: gpt-6.1-sol
    reasoning_effort: medium
    canonical_identity: gpt-6.1-sol
    auth: openai_oauth
    oauth: true
    # selection: the operator's instruction at dispatch chooses the arm; when it names neither,
    # the OpenAI OAuth arm (B) is the default. The two arms are CO-EQUAL; neither is a fallback
    # of the other, so neither appears in `fallbacks`.
    selection_authority: operator-instruction-at-dispatch
    arms:
      - arm: A
        model: glm-5.3-flash
        provider: opencode-go
        canonical_identity: glm-5.3-flash
        auth: env_ref:OPENCODE_GO_API_KEY
        oauth: false
        reasoning_effort: medium
        co_equal: true
      - arm: B
        model: gpt-6.1-sol
        provider: openai-codex
        canonical_identity: gpt-6.1-sol
        auth: openai_oauth
        oauth: true
        reasoning_effort: medium
        co_equal: true
    fallbacks: []
    admission_status: UNPROVEN

invariants:
  unknown_lane: DENY
  maker_checker_distinct_model: true
  provider_separation_required: false
  de_modeled_allowed: false
  per_lane_authority: HGK-ExecutionBinding-TaskSpec-role
  global_overrides_permitted: false

# sod_invariants: the maker (writer/executor) must never share a normalized model token with the
# checker (verifier/acceptance) for the same subject. model_axis is the load-bearing axis;
# provider_axis is recorded for honesty only (EXECUTE and VERIFY_SECURITY share opencode-go, so
# provider separation does NOT hold and is explicitly NOT required).
sod_invariants:
  comparison_axis: canonical_identity
  provider_axis_required: false
  pairs:
    - maker: EXECUTE
      checker: VERIFY_SECURITY
      distinct_required: true
      note: EXECUTE deepseek-v4.1-flash vs VERIFY glm-5.3-flash — distinct model families.
    - maker: EXECUTE
      checker: PLAN
      distinct_required: true
      note: A plan-lane acting as checker must still differ from the executor model.
    - maker: PLAN
      checker: VERIFY_SECURITY
      distinct_required: true
      note: COLLIDES on the default arm B (gpt-6.1-sol == gpt-6.1-sol); DISTINCT on arm A (glm-5.3-flash). Declared conflict SOD006-C1, frozen for adjudication.

  declared_conflicts:
    - id: SOD006-C1
      pairs: [[PLAN, VERIFY_SECURITY]]
      axis: canonical_identity
      resolution: NONE - implemented as instructed and surfaced for adjudication; never silently resolved

# projections[] — every live site that must agree with routes above. Each projection has a path
# (relative to the HG-KSEOS root) and bindings[] of (json_pointer, expected). check_drift() reads
# each site read-only and returns one finding per mismatch, named by path + JSON pointer.
#
# debt[] entries are live sites that do NOT yet agree with the registry but are recorded as known
# debt (e.g. the legacy AppData binding in config/hermes.json). They are reported by check_drift as
# the typed code PROJECTION_DEBT (warn severity) rather than DRIFT_VALUE, so the drift gate stays a
# truthful hard-fail on the reproducibility sites (registry source + sealed lane) while not
# pretending the migration is already done. Debt is never a PASS proxy.
