208|def closure_findings(bundle: dict[str, dict[str, Any]]) -> dict[str, Any]:
209|    """Atomic graph closure over the bundle's trace edges (S4EXT-R1 TT-S4EXT-002 / F002).
210|
211|    ``state`` is one of:
212|
213|    * ``SCHEMA_ONLY`` - the bundle carries NO trace edge, so no graph relation exists to close.
214|      This is a legal PARTIAL bundle (e.g. a scoped validate of LITE artifacts). It is labelled
215|      explicitly so a caller can never read a schema-only result as a trace-closed one.
216|    * ``FULL`` - every edge resolved: both endpoints exist inside the bundle and both recorded
217|      hashes equal the real endpoint hashes.
218|    * ``FAILED`` - at least one orphan endpoint or hash mismatch; a finding is emitted per problem.
219|      A bundle in this state can never return PASS.
220|
221|    The closure REUSES ``pipeline.trace_closure`` (the C-10 repair that recomputes both sides of
222|    every edge) rather than introducing a second trace engine.
223|    """
224|    records = {k: v for k, v in bundle.items() if isinstance(v, dict)}
225|    edge_count = sum(len(trace_edges(r)) for r in records.values())
226|    if edge_count == 0:
227|        return {"state": "SCHEMA_ONLY", "edges": 0, "findings": []}
228|    from . import pipeline  # local import: pipeline imports this module for the shared field lists
229|    try:
230|        report = pipeline.trace_closure(records)
231|    except Exception as exc:  # fail closed: an unclosable graph is not a closed graph
232|        return {"state": "FAILED", "edges": edge_count,
233|                "findings": [{"contract": "*", "kind": "CLOSURE",
234|                              "detail": f"trace closure could not be computed: {exc!r}"}]}
235|    problems: list[str] = []
236|    # S4EXT-R1 external-AO finding C3: a syntactically valid endpoint whose declared TYPE
237|    # contradicts the family of the record its id actually resolves to must fail closed. Without
238|    # this, "PD-PKG/from" could point at a PI-PKG record and still be reported as a closed graph.
239|    family_of: dict[str, str] = {}
240|    for name, rec in records.items():
241|        fam = str(rec.get("schema_version") or "").split("@")[0] or name
242|        if rec.get("subject_id"):
243|            family_of[str(rec["subject_id"])] = fam
244|        for atom in (rec.get("stable_semantic_contract", {}) or {}).get("atoms", []) or []:
245|            if isinstance(atom, dict) and atom.get("subject_id"):
246|                # an atom declares its OWN family (RequirementAtom@1), not the parent's
247|                afam = str(atom.get("schema_version") or "").split("@")[0] or fam
248|                family_of[str(atom["subject_id"])] = afam
249|    for _name, rec in records.items():
250|        for edge in trace_edges(rec):
251|            for side in ("from", "to"):
252|                declared = edge.get(f"{side}_type")
253|                resolved = family_of.get(str(edge.get(f"{side}_id") or ""))
254|                if declared and resolved and str(declared) != resolved:
255|                    problems.append(
256|                        "endpoint type contradicts the resolved record family: "
257|                        f"{side}_type={declared} but {side}_id={edge.get(f'{side}_id')} "
258|                        f"resolves to {resolved}")
259|    for orphan in report.get("orphans") or []:
