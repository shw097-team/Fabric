+def write_receipt(path, rec: dict) -> str:
+    """Persist a receipt without destroying an earlier attempt's record.
+
+    FAR018-ER1: every receipt path is fixed, so a RETRY used to overwrite the
+    first attempt's refusal and lose exactly the record the round needed to
+    recover by hand. This preserves prior bytes: if the destination already
+    holds a DIFFERENT receipt, the existing receipt is first archived verbatim
+    to a numbered sibling ``<path>.attempt-N`` (N = count of archives + 1), then
+    the new receipt is written to the original path. Identical rewrites, and
+    first writes, keep the old behaviour and never create an archive.
+
+    Returns the archive path when one was written, else None.
+    """
+    out = Path(path)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    new_text = json.dumps(rec, indent=2, ensure_ascii=False)
+    if out.exists():
+        try:
+            old_text = out.read_text(encoding="utf-8")
+        except OSError:
+            old_text = None
+        if old_text is not None and old_text != new_text:
+            existing = sorted(out.parent.glob(out.name + ".attempt-*"))
+            archive = out.parent / f"{out.name}.attempt-{len(existing) + 1}"
+            archive.write_text(old_text, encoding="utf-8")
+            out.write_text(new_text, encoding="utf-8")
+            return str(archive)
+    out.write_text(new_text, encoding="utf-8")
+    return None
+
