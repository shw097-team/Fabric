412|def derive_frozen_context(source: dict[str, Any] | None = None, *,
413|                          trace_endpoint_hashes: dict[str, str] | None = None,
414|                          profile_requirement: dict[str, Any] | None = None,
415|                          oracle_expected: dict[str, str] | None = None) -> dict[str, Any]:
416|    """Assemble a deterministic frozen context for ``validate_bundle``.
417|
418|    The pieces are all caller-held data; nothing here consults an LLM, the network or any clock.
419|    A PI package carries its atoms and trace links, so when ``source`` is a PI package the
420|    subject->digest endpoint map and the oracle-expected map are read straight from it. Profile
421|    requirements come from the frozen ``profiles.PROFILES`` table by default. Only derivable
422|    pieces are emitted: a map is omitted (rather than guessed) when its source is absent, so the
423|    validator's fail-closed branch for that binding still fires.
424|    """
425|    from .profiles import PROFILES
426|    ctx: dict[str, Any] = {}
427|    endpoint_hashes = dict(trace_endpoint_hashes or {})
428|    oracle_expected_map = dict(oracle_expected or {})
429|    if isinstance(source, dict):
430|        ssc = source.get("stable_semantic_contract") or {}
431|        for atom in ssc.get("atoms") or []:
432|            if atom.get("subject_id") and atom.get("content_hash"):
433|                endpoint_hashes.setdefault(atom["subject_id"], atom["content_hash"])
434|            oracle = ((atom.get("risk_guard") or {}).get("oracle") or {})
435|            if atom.get("req_id") and oracle.get("expected") is not None:
436|                oracle_expected_map.setdefault(atom["req_id"], oracle["expected"])
437|        if source.get("subject_id") and source.get("content_hash"):
438|            endpoint_hashes.setdefault(source["subject_id"], source["content_hash"])
439|    if endpoint_hashes:
440|        ctx["trace_endpoint_hashes"] = endpoint_hashes
441|    if oracle_expected_map:
442|        ctx["oracle_expected"] = oracle_expected_map
443|    ctx["profile_requirement"] = profile_requirement or {
444|        name: {"assurance": list(spec["assurance"]), "artifact_depth": spec["artifact_depth"]}
445|        for name, spec in PROFILES.items()}
446|    return ctx

