220|    """Validate a PI package - the PI-PKG record, its ProfileBinding, every RequirementAtom and
221|    every TraceLink - against the frozen context derived from itself.
222|
223|    Deterministic only. This is the pipeline-level entrypoint that threads the optional frozen
224|    context through to the hardened `semantic_invariants`, so the trace-digest / oracle-expected /
225|    profile-assurance bindings are checked on the compiler's own output.
226|    """
227|    from . import validate as _validate
228|    ctx = _validate.derive_frozen_context(pi)
229|    findings: list[dict[str, str]] = list(
230|        _validate.validate_bundle({"PI-PKG": strip_sidecar(pi)}, schemas_dir, ctx)["findings"])
231|    ssc = pi.get("stable_semantic_contract") or {}
232|    members: list[tuple[str, dict[str, Any]]] = []
233|    if isinstance(ssc.get("profile_binding"), dict):
234|        members.append(("ProfileBinding", ssc["profile_binding"]))
235|    members += [("RequirementAtom", a) for a in (ssc.get("atoms") or []) if isinstance(a, dict)]
236|    members += [("TraceLink", t) for t in (pi.get("trace") or []) if isinstance(t, dict)]
237|    for contract, rec in members:
238|        for f in _validate.validate_record(contract, rec, schemas_dir):
239|            findings.append({"contract": contract, "kind": "SCHEMA", "detail": f})
240|        for f in _validate.semantic_invariants(contract, rec, ctx):
241|            findings.append({"contract": contract, "kind": "SEMANTIC", "detail": f})
242|    return {"verdict": "PASS" if not findings else "FAIL",
243|            "checked": 1 + len(members), "findings": findings}
