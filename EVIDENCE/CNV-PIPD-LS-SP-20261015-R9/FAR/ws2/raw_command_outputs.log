322|def closure_findings(bundle: dict[str, dict[str, Any]]) -> dict[str, Any]:
323|    """Atomic graph closure over the bundle's trace edges (S4EXT-R1 TT-S4EXT-002 / F002).
324|
325|    ``state`` is one of:
326|
327|    * ``SCHEMA_ONLY`` - the bundle carries NO trace edge, so no graph relation exists to close.
328|      This is a legal PARTIAL bundle (e.g. a scoped validate of LITE artifacts). It is labelled
329|      explicitly so a caller can never read a schema-only result as a trace-closed one.
330|    * ``FULL`` - every edge resolved: both endpoints exist inside the bundle and both recorded
331|      hashes equal the real endpoint hashes.
332|    * ``FAILED`` - at least one orphan endpoint or hash mismatch; a finding is emitted per problem.
333|      A bundle in this state can never return PASS.
334|
335|    The closure REUSES ``pipeline.trace_closure`` (the C-10 repair that recomputes both sides of
336|    every edge) rather than introducing a second trace engine.
337|    """
338|    records = {k: v for k, v in bundle.items() if isinstance(v, dict)}
339|    edge_count = sum(len(trace_edges(r)) for r in records.values())
340|    if edge_count == 0:
341|        return {"state": "SCHEMA_ONLY", "edges": 0, "findings": []}
342|    from . import pipeline  # local import: pipeline imports this module for the shared field lists
343|    try:
344|        report = pipeline.trace_closure(records)
345|    except Exception as exc:  # fail closed: an unclosable graph is not a closed graph
346|        return {"state": "FAILED", "edges": edge_count,
347|                "findings": [{"contract": "*", "kind": "CLOSURE",
348|                              "detail": f"trace closure could not be computed: {exc!r}"}]}
349|    problems: list[str] = []
350|    # S4EXT-R1 external-AO finding C3: a syntactically valid endpoint whose declared TYPE
351|    # contradicts the family of the record its id actually resolves to must fail closed. Without
352|    # this, "PD-PKG/from" could point at a PI-PKG record and still be reported as a closed graph.
353|    family_of: dict[str, str] = {}
354|    for name, rec in records.items():
355|        fam = str(rec.get("schema_version") or "").split("@")[0] or name
356|        if rec.get("subject_id"):
357|            family_of[str(rec["subject_id"])] = fam
358|        for atom in (rec.get("stable_semantic_contract", {}) or {}).get("atoms", []) or []:
359|            if isinstance(atom, dict) and atom.get("subject_id"):
360|                # an atom declares its OWN family (RequirementAtom@1), not the parent's
361|                afam = str(atom.get("schema_version") or "").split("@")[0] or fam
362|                family_of[str(atom["subject_id"])] = afam
363|    for _name, rec in records.items():
364|        for edge in trace_edges(rec):
365|            for side in ("from", "to"):
366|                declared = edge.get(f"{side}_type")
367|                resolved = family_of.get(str(edge.get(f"{side}_id") or ""))
368|                if declared and resolved and str(declared) != resolved:
369|                    problems.append(
370|                        "endpoint type contradicts the resolved record family: "
371|                        f"{side}_type={declared} but {side}_id={edge.get(f'{side}_id')} "
372|                        f"resolves to {resolved}")
373|    for orphan in report.get("orphans") or []:
374|        problems.append(f"orphan trace endpoint: {orphan} is not present in the bundle")
375|    for bad in report.get("bad_hashes") or []:
376|        problems.append(f"trace endpoint hash mismatch: {bad}")
377|    if report.get("verdict") != "PASS" and not problems:
378|        problems.append("trace closure did not reach PASS over the bundle")
379|    return {"state": "FULL" if not problems else "FAILED", "edges": int(report.get("edges") or edge_count),
380|            "findings": [{"contract": "*", "kind": "CLOSURE", "detail": p} for p in problems]}
381|
382|
383|def validate_bundle(bundle: dict[str, dict[str, Any]], schemas_dir: Path | None = None,
384|                    frozen_context: dict[str, Any] | None = None) -> dict[str, Any]:
385|    findings: list[dict[str, str]] = []
386|    # C-4 repair: validate_bundle({}) used to return PASS with checked=0. An empty denominator is
387|    # not a verification result.
388|    if not bundle:
389|        return {"verdict": "FAIL", "checked": 0, "closure": "SCHEMA_ONLY",
390|                "findings": [{"contract": "*", "kind": "DENOMINATOR",
391|                              "detail": "empty bundle: zero records checked cannot be a PASS"}]}
392|    for contract, record in bundle.items():
393|        if not isinstance(record, dict):
394|            findings.append({"contract": contract, "kind": "SCHEMA",
395|                             "detail": "record must be an object"})
396|            continue
397|        for f in validate_record(contract, record, schemas_dir):
398|            findings.append({"contract": contract, "kind": "SCHEMA", "detail": f})
399|        for f in semantic_invariants(contract, record, frozen_context):
400|            findings.append({"contract": contract, "kind": "SEMANTIC", "detail": f})
401|    # TT-S4EXT-002: `pipd validate --bundle` used to stop at the per-record schema/semantic checks,
402|    # so a bad endpoint hash, an orphan edge or a missing endpoint could still return PASS even
403|    # though pipeline.trace_closure() already knew how to refuse it. The closure is now part of the
404|    # bundle verdict, and a bundle with no trace edge is labelled SCHEMA_ONLY rather than passed off
405|    # as trace-closed.
406|    closure = closure_findings(bundle)
407|    findings.extend(closure["findings"])
408|    return {"verdict": "PASS" if not findings else "FAIL",
409|            "checked": len(bundle), "closure": closure["state"], "findings": findings}
410|
