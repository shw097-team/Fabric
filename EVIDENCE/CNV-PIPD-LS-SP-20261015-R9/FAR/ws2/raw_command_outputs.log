1307|def _authorization_spine():
1308|    """Open the canonical Shared Spine for the D4 single-use authorization claim.
1309|
1310|    Returns ``(spine, None)`` on success or ``(None, detail)`` when the Spine/claim helper cannot be
1311|    reached. A caller MUST refuse when this returns a detail: an unacquirable boundary is a refusal,
1312|    never a silent "no budget" pass.
1313|    """
1314|    if _authz is None:
1315|        return None, "the authorization_claim helper could not be imported"
1316|    try:
1317|        SharedSpine = _authz._load_spine(ROOT)
1318|        # An explicit override keeps the boundary testable against a throwaway Spine DB (and lets an
1319|        # operator point the claim at an isolated DB); otherwise the canonical Shared Spine is used.
1320|        db = Path(os.environ.get("HGK_SPINE_DB") or SPINE_DB)
1321|        schema = Path(os.environ.get("HGK_SPINE_SCHEMA") or SPINE_SCHEMA)
1322|        return SharedSpine(db, schema), None
1323|    except Exception as exc:  # noqa: BLE001 - surface the reason; do not fall through to a pass
1324|        return None, f"{type(exc).__name__}: {exc}"
