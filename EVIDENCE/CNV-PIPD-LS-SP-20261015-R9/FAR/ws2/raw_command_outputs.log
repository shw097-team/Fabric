310|def trace_edges(record: dict[str, Any]) -> list[dict[str, Any]]:
311|    """The trace edges a single record carries (PI-PKG nests them; TraceLink is one edge)."""
312|    if not isinstance(record, dict):
313|        return []
314|    trace = record.get("trace")
315|    if isinstance(trace, list):
316|        return [e for e in trace if isinstance(e, dict)]
317|    if record.get("from_id") and record.get("to_id"):
318|        return [record]
319|    return []
