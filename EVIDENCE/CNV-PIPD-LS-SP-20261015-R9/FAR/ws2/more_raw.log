389|        return {"verdict": "FAIL", "checked": 0, "closure": "SCHEMA_ONLY",
390|                "findings": [{"contract": "*", "kind": "DENOMINATOR",
391|                              "detail": "empty bundle: zero records checked cannot be a PASS"}]}
392|    for contract, record in bundle.items():
393|        if not isinstance(record, dict):
394|            findings.append({"contract": contract, "kind": "SCHEMA",
395|                             "detail": "record must be an object"})
396|            continue
397|        for f in validate_record(contract, record, schemas_dir):
398|            findings.append({"contract": contract, "kind": "SCHEMA", "detail": f})
399|        for f in semantic_invariants(contract, record, frozen_context):
400|            findings.append({"contract": contract, "kind": "SEMANTIC", "detail": f})
401|    # TT-S4EXT-002: `pipd validate --bundle` used to stop at the per-record schema/semantic checks,
402|    # so a bad endpoint hash, an orphan edge or a missing endpoint could still return PASS even
403|    # though pipeline.trace_closure() already knew how to refuse it. The closure is now part of the
404|    # bundle verdict, and a bundle with no trace edge is labelled SCHEMA_ONLY rather than passed off
405|    # as trace-closed.
406|    closure = closure_findings(bundle)
407|    findings.extend(closure["findings"])
408|    return {"verdict": "PASS" if not findings else "FAIL",
409|            "checked": len(bundle), "closure": closure["state"], "findings": findings}
