# transport_model_constraints (epoch 15) — MEASURED, not assumed. Two independent facts constrain the
# token a lane may send to the Codex CLI:
#   (a) codex resolves per-model metadata from the lane catalog BY SLUG;
#   (b) a token that is not routable fails before metadata matters at all.
# The two constraints do NOT agree for every arm, and where they conflict this registry records the
# accepted trade-off instead of pretending it is resolved.
transport_model_constraints:
  rule_source: "measured 2026-10-10 (E4/E5b/E6/E7 + direct codex probes); evidence under evidence/review/"
  metadata_lookup_key: catalog slug
  claim_ceiling: >-
    A successful lane turn proves the token is routable and dispatchable. It does NOT prove the model
    ran with its catalog metadata (context window, reasoning levels, tool mode, apply_patch type).
    Any statement about model capability stays at that ceiling.
  opencode_go:
    required_form: "provider-qualified slug (opencode-go/<model>)"
    accepted_example: "opencode-go/deepseek-v4.1-flash"
    bare_name: "routes, but codex prints 'Model metadata for <model> not found. Defaulting to fallback metadata'"
    status: RESOLVED
  nvidia:
    required_form: "nvidia/<vendor>/<model> (slash form) — routable"
    catalog_slug_form: "nvidia/<vendor>-<model> (hyphen form) — the catalog key"
    catalog_slug_routable: false
    observed_failure_on_catalog_slug: "426 Upgrade Required / Provider stream error: Invalid request"
    accepted_trade_off: >-
      Routability and metadata resolution CANNOT both be satisfied for this arm: the lane keeps the
      routable slash form and ACCEPTS fallback metadata. This is a recorded limitation, not a defect
      to be repaired by renaming the token.
    status: ACCEPTED_LIMITATION
  openai_codex:
    required_form: "bare model id (gpt-6.1-sol, gpt-6-luna)"
    rejected_form: "openai-codex/<model> — HTTP 400 (routed to the default provider)"
    catalog_entry: absent
    accepted_trade_off: >-
      No catalog entry exists for these ids, so this arm also runs on fallback metadata. Authoring
      catalog metadata for a model the catalog does not describe would be declaring capability facts
      that were never measured; that is NOT authorised and is not done.
    status: ACCEPTED_LIMITATION

# C6 correlation contract (epoch 15) — closes the "a front-door decision cannot be joined to the
# upstream spend row" gap by construction rather than by matching heuristics.
# The relay persists sha256(<session header>)[:32] as its usage.jsonl `conversationId`, and its own
# source documents that field as a log/usage correlation id only (opencodex 2.11.0
# src/server/request-log-conversation.ts). The front door therefore strips any client session/thread
# header, plants `session_id: hgkfd-<correlation_id>` on the upstream request, and records
# `upstream_conversation_id` (the value the relay will write) plus `client_session_sha256` (the
# digest of whatever the client sent) on every FORWARD row.
correlation_contract:
  ledger_key: upstream_conversation_id
  relay_field: conversationId
  derivation: "sha256('hgkfd-' + correlation_id)[:32]"
  join_rule: "usage.jsonl.conversationId == ledger.upstream_conversation_id (per request), fallback == ledger.client_session_sha256 (per conversation)"
  spoof_proof: "client-supplied session_id/session-id/x-session-id/thread-id are stripped before the value is set; measured E10: the client's value only ever appears as client_session_sha256"
  verified: "E9 2026-10-10 — ledger row correlation_id 3e86af839cde421195fed70948a341e0 / upstream_conversation_id 548ef9e9d0996a690e0156e27a895dcd equals usage.jsonl requestId ocx-mv28ampx-57 conversationId (status 200, opencode-go/deepseek-v4.1-flash, 9871 tokens)"

