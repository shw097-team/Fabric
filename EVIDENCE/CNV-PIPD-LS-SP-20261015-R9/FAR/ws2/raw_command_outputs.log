263|    if report.get("verdict") != "PASS" and not problems:
264|        problems.append("trace closure did not reach PASS over the bundle")
265|    return {"state": "FULL" if not problems else "FAILED", "edges": int(report.get("edges") or edge_count),
266|            "findings": [{"contract": "*", "kind": "CLOSURE", "detail": p} for p in problems]}
